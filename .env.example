# TerraLens AI Environment Configuration Template
# Copy this file to .env and customize as needed.

# Application Configuration
TERRALENS_ENV=development
TERRALENS_DEBUG=true
TERRALENS_LOG_LEVEL=INFO

# Data Paths
TERRALENS_DATA_DIR=data
TERRALENS_METADATA_PATH=data/metadata/locations.json
TERRALENS_INDEX_DIR=indexes

# Prototype Settings
TERRALENS_DATASET_NAME=Prototype Dataset (SIH-2026 Sandbox)
TERRALENS_STRICT_METADATA=true

# Future Model Configuration (Phase 2)
# TERRALENS_EMBEDDING_MODEL=openai/clip-vit-base-patch32
# TERRALENS_DEVICE=cpu
# TERRALENS_FAISS_INDEX_PATH=indexes/satellite_embeddings.index
